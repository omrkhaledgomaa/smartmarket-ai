PORT=3000
# Development option: plain secret env value (12+ characters); prefer hash in deployment.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Production-preferred: run `npm run hash-password` and set the resulting scrypt hash instead.
# Do not set both. If ADMIN_PASSWORD_HASH is set, it takes precedence.
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=false
# DATA_DIR=/absolute/path/to/persistent/data
# BACKUP_DIR=/absolute/path/to/backups
